# Live domain, used for canonical URLs, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.salnethub.com

# Leads sheet: Apps Script web app URL and shared secret (see apps-script/leads/Code.gs)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Site chat: the n8n "SalnetHub KB – Website Chat" production webhook URL and its X-SalnetHub-Secret header value
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=

# Book a call calendar (see README → Booking calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The Google account that owns the calendar; booking emails are sent from it
BOOKING_OWNER_EMAIL=
# Optional: where new-booking alerts go (defaults to BOOKING_OWNER_EMAIL)
BOOKING_NOTIFY_EMAIL=
# Optional: a calendar other than the main one
GOOGLE_CALENDAR_ID=

# Set to "github" to edit case studies from the live site (see README)
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# Optional override of the GA4 Measurement ID (default lives in src/content/site.ts). GA loads on production only.
NEXT_PUBLIC_GA_ID=
# Optional: Search Console HTML-tag verification code (not needed with DNS verification)
NEXT_PUBLIC_GSC_VERIFICATION=
