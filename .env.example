# Live domain, used for canonical URLs, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=https://salnethub.xyz

# Free contact form delivery: https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Book a call calendar (see README → Booking calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The Google account that owns the calendar; booking emails are sent from it
BOOKING_OWNER_EMAIL=
# Optional: where new-booking alerts go (defaults to BOOKING_OWNER_EMAIL)
BOOKING_NOTIFY_EMAIL=
# Optional: a calendar other than the main one
GOOGLE_CALENDAR_ID=

# Set to "github" to edit case studies from the live site (see README)
NEXT_PUBLIC_KEYSTATIC_STORAGE=
